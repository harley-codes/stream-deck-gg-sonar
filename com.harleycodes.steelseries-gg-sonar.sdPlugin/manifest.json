{
	"Name": "SteelSeries GG Sonar Controls",
	"Version": "1.1.0.0",
	"Author": "HarleyCodes",
	"Actions": [
		{
			"Name": "Channel Dial - Classic",
			"UUID": "com.harleycodes.steelseries-gg-sonar.channel-dial-classic",
			"Icon": "imgs/actions/dial-action-icon",
			"Tooltip": "Control volume of a channel in Sonar.",
			"PropertyInspectorPath": "ui/channel-dial-classic.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "$B1",
				"TriggerDescription": {
					"Rotate": "Adjust Volume",
					"Push": "Toggle Mute"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/dial-action-icon"
				}
			]
		},
		{
			"Name": "Channel Dial - Streamer",
			"UUID": "com.harleycodes.steelseries-gg-sonar.channel-dial-streamer",
			"Icon": "imgs/actions/dial-action-icon",
			"Tooltip": "Control volume of a channel in Sonar.",
			"PropertyInspectorPath": "ui/channel-dial-streamer.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "$C1",
				"TriggerDescription": {
					"Rotate": "Adjust Volume",
					"Push": "Toggle Mute",
					"Touch": "Toggle Target"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/dial-action-icon"
				}
			]
		},
		{
			"Name": "CHATMIX Dial",
			"UUID": "com.harleycodes.steelseries-gg-sonar.chatmix-dial",
			"Icon": "imgs/actions/chatmix-action-icon",
			"Tooltip": "Control CHATMIX in Sonar.",
			"PropertyInspectorPath": "ui/chatmix-dial.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "$B2",
				"TriggerDescription": {
					"Rotate": "Adjust Volume"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/chatmix-action-padded-icon"
				}
			]
		}
	],
	"Category": "SteelSeries GG Sonar",
	"CategoryIcon": "imgs/plugin/plugin-category",
	"CodePath": "bin/plugin.js",
	"Description": "Control the SteelSeries GG Sonar software from your Stream Deck.",
	"Icon": "imgs/plugin/plugin-category-png",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "6.9"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "20",
		"Debug": "enabled"
	},
	"UUID": "com.harleycodes.steelseries-gg-sonar"
